# PostHog (Vite embeds these at build time — set on Render Build env too)
# Project API Key is a public client key (safe in the browser bundle).
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: enable Session Replay (all inputs + all text masked)
# VITE_PUBLIC_POSTHOG_REPLAY=true
