require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'
require 'fileutils'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityAdmob', :path => '../../node_modules/@capacitor-community/admob'
  pod 'CapacitorFirebaseAnalytics', :path => '../../node_modules/@capacitor-firebase/analytics'
  pod 'CapacitorCamera', :path => '../../node_modules/@capacitor/camera'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
end

def apply_wasewase_ios_patches!
  admob_dest = File.expand_path(
    '../../node_modules/@capacitor-community/admob/ios/Sources/AdMobPlugin/AdMobPlugin.swift',
    __dir__
  )
  admob_src = File.expand_path('patches/AdMobPlugin.no-att.swift', __dir__)
  if File.exist?(admob_src) && File.exist?(File.dirname(admob_dest))
    FileUtils.cp(admob_src, admob_dest)
    puts '[WASE] Applied AdMob ATT removal patch'
  end

  info_plist = File.join(__dir__, 'App', 'Info.plist')
  if File.exist?(info_plist)
    system('plutil', '-remove', 'NSUserTrackingUsageDescription', info_plist)
    ensure_camera_photo_usage_descriptions!(info_plist)
  end
end

def ensure_camera_photo_usage_descriptions!(info_plist)
  # Capacitor Camera 必須。欠けていると権限ダイアログ前にクラッシュする。
  descriptions = {
    'NSCameraUsageDescription' =>
      '投稿やプロフィール用の写真を撮影するために、カメラへのアクセスが必要です。',
    'NSPhotoLibraryUsageDescription' =>
      'プロフィール画像や投稿画像を選ぶために、写真ライブラリへのアクセスが必要です。',
    'NSPhotoLibraryAddUsageDescription' =>
      '撮影した画像を写真ライブラリに保存するためにアクセスが必要です。'
  }

  descriptions.each do |key, value|
    # 既存キーは replace、無い場合は insert
    ok = system('plutil', '-replace', key, '-string', value, info_plist)
    unless ok
      system('plutil', '-insert', key, '-string', value, info_plist)
    end
  end
  puts '[WASE] Ensured NSCamera/NSPhotoLibrary usage descriptions in Info.plist'
end
target 'App' do
  capacitor_pods
  # Add your Pods here
  pod 'CapacitorFirebaseAnalytics/AnalyticsWithoutAdIdSupport', :path => '../../node_modules/@capacitor-firebase/analytics'
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # App target is iOS 15+; keep all CocoaPods targets aligned so embedded
  # frameworks/bundles ship MinimumOSVersion >= 15.0 after Archive.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f
      if deployment_target < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
  apply_wasewase_ios_patches!
end
